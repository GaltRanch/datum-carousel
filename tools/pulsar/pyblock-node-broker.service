[Unit]
Description=PyBLØCK PULSAR — broker RPC de Node B para la flota de gateways (pyblock-node-broker)
After=network-online.target pyblock-bip110-node.service
Wants=pyblock-bip110-node.service

[Service]
Type=simple
User=curly
# glibc: 24 hilos × arenas reteniendo chunks de ~100 KB (GBT) inflan el RSS sin ser fuga; misma mitigación que bitcoind.
Environment=MALLOC_ARENA_MAX=2
ExecStart=/usr/local/bin/pyblock-node-broker /etc/pyblock/node-broker.json
Restart=always
RestartSec=2
LimitNOFILE=65536
MemoryMax=512M
MemoryAccounting=yes
CPUWeight=500

[Install]
WantedBy=multi-user.target
